digraph circuit {
  graph [rankdir=LR, bgcolor="white", nodesep=0.2, ranksep=0.6];
  node [shape=plain, fontname="Arial", fontsize=10];
  edge [color="#64748b", arrowhead=none, tailport="o:e"];
  label="Gate symbols preview";
  labelloc="t";
  graph [splines=line, nslimit=0.1, nslimit1=0.1, mclimit=0.1];
  n0 [label=<<TABLE BORDER="1" COLOR="#334155" BGCOLOR="#dbeafe" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="1" WIDTH="72">A</TD><TD PORT="o" ROWSPAN="1" WIDTH="1"></TD></TR></TABLE>>, tooltip="Node 0: INPUT"];
  n1 [label=<<TABLE BORDER="1" COLOR="#334155" BGCOLOR="#dbeafe" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="1" WIDTH="72">B</TD><TD PORT="o" ROWSPAN="1" WIDTH="1"></TD></TR></TABLE>>, tooltip="Node 1: INPUT"];
  n2 [label=<<TABLE BORDER="0" COLOR="#334155" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="2" WIDTH="60" HEIGHT="40" FIXEDSIZE="TRUE"><IMG SRC="C:/Users/idec/Desktop/chohyunkeon/project/Algorithm/optimal-tree-converting/utiles/symbols/and.svg" SCALE="TRUE"/></TD><TD PORT="o" ROWSPAN="2" WIDTH="1"></TD></TR><TR><TD PORT="i1" WIDTH="1" HEIGHT="20"></TD></TR></TABLE>>, tooltip="Node 2: AND"];
  n3 [label=<<TABLE BORDER="0" COLOR="#334155" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="2" WIDTH="60" HEIGHT="40" FIXEDSIZE="TRUE"><IMG SRC="C:/Users/idec/Desktop/chohyunkeon/project/Algorithm/optimal-tree-converting/utiles/symbols/nand.svg" SCALE="TRUE"/></TD><TD PORT="o" ROWSPAN="2" WIDTH="1"></TD></TR><TR><TD PORT="i1" WIDTH="1" HEIGHT="20"></TD></TR></TABLE>>, tooltip="Node 3: NAND"];
  n4 [label=<<TABLE BORDER="0" COLOR="#334155" BGCOLOR="white" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="40"></TD><TD ROWSPAN="1" WIDTH="60" HEIGHT="40" FIXEDSIZE="TRUE"><IMG SRC="C:/Users/idec/Desktop/chohyunkeon/project/Algorithm/optimal-tree-converting/utiles/symbols/not.svg" SCALE="TRUE"/></TD><TD PORT="o" ROWSPAN="1" WIDTH="1"></TD></TR></TABLE>>, tooltip="Node 4: INV"];
  n5 [label=<<TABLE BORDER="1" COLOR="#334155" BGCOLOR="#fef9c3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="2" WIDTH="72">OR</TD><TD PORT="o" ROWSPAN="2" WIDTH="1"></TD></TR><TR><TD PORT="i1" WIDTH="1" HEIGHT="20"></TD></TR></TABLE>>, tooltip="Node 5: OR"];
  n6 [label=<<TABLE BORDER="1" COLOR="#334155" BGCOLOR="#dcfce7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="1" WIDTH="72">Y</TD><TD PORT="o" ROWSPAN="1" WIDTH="1"></TD></TR></TABLE>>, tooltip="Node 6: OUTPUT"];
  n7 [label=<<TABLE BORDER="1" COLOR="#334155" BGCOLOR="#dcfce7" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD PORT="i0" WIDTH="1" HEIGHT="20"></TD><TD ROWSPAN="1" WIDTH="72">Z</TD><TD PORT="o" ROWSPAN="1" WIDTH="1"></TD></TR></TABLE>>, tooltip="Node 7: OUTPUT"];
  n0 -> n2 [headport="i0:w", tooltip="Node 0 -> Node 2, input port 0"];
  n1 -> n2 [headport="i1:w", tooltip="Node 1 -> Node 2, input port 1"];
  n0 -> n3 [headport="i0:w", tooltip="Node 0 -> Node 3, input port 0"];
  n1 -> n3 [headport="i1:w", tooltip="Node 1 -> Node 3, input port 1"];
  n2 -> n4 [headport="i0:w", tooltip="Node 2 -> Node 4, input port 0"];
  n4 -> n5 [headport="i0:w", tooltip="Node 4 -> Node 5, input port 0"];
  n3 -> n5 [headport="i1:w", tooltip="Node 3 -> Node 5, input port 1"];
  n5 -> n6 [headport="i0:w", tooltip="Node 5 -> Node 6, input port 0"];
  n3 -> n7 [headport="i0:w", tooltip="Node 3 -> Node 7, input port 0"];
}
